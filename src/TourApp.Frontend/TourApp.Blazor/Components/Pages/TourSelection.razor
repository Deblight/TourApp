@page "/tour"
@rendermode InteractiveServer

<h1 class="title">Tour Selection</h1>

<EditForm Model="@model" OnValidSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="field">
        <label for="name">Name</label>
        <InputText id="name" class="input" @bind-Value="model.Name" />
        <ValidationMessage For="() => model.Name" />
    </div>

    <div class="field">
        <label for="email">Email</label>
        <InputText id="email" class="input" @bind-Value="model.Email" />
        <ValidationMessage For="() => model.Email" />
    </div>

    <div class="field">
        <label for="tour">Tours</label>
        <InputSelect id="tour" class="select" @bind-Value="model.TourId">
            <option value="">Choose one</option>
            @foreach (var t in tours)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="() => model.TourId" />
    </div>

    <div class="field inline">
        <InputRadioGroup @bind-Value="model.Action">
            <InputRadio Value="SignupAction.Book" /> <span>Book</span>
            <InputRadio Value="SignupAction.Cancel" class="ms-3" /> <span>Cancel</span>
        </InputRadioGroup>
        <ValidationMessage For="() => model.Action" />
    </div>

    <button disabled="@busy" class="btn">
        @(busy ? "Submitting..." : "Submit")
    </button>
</EditForm>

@if (toast is not null)
{
    <div class="toast @(toast.Success ? "ok" : "bad")" role="status" aria-live="polite">@toast.Message</div>
}
<script src="_framework/blazor.web.js"></script>

