@using Microsoft.AspNetCore.Components.Routing

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">TourApp</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" @onclick="() => Toggle(false)">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/tour">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Tour
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private void Toggle(bool? value = null)
    {
        // hvis du vil styre checkbox’en via kode, ellers kan du slette hele Toggle-delen
    }
}
